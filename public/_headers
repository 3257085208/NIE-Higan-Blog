/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://waline.example.com; script-src 'self' https://cubism.live2d.com; style-src 'self' 'unsafe-inline' https://cdn.staticfile.org.i8-mc.cn; font-src 'self' data: https://cdn.staticfile.org.i8-mc.cn; img-src 'self' data: blob: https:; connect-src 'self' https://example.com https://api.example.com https://waline.example.com https://fastly.jsdelivr.net https://cubism.live2d.com; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
